        <!-- IULogin Class -->
        <mxCell id="c_iulogin" value="&lt;p style=&quot;margin:0px;padding-top:4px;text-align:center;&quot;&gt;&lt;b&gt;IULogin&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- gestionnaire: GestionnairePersonne&lt;br&gt;- nom: string&lt;br&gt;- motDePasse: string&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ IULogin()&lt;br&gt;+ setGestionnaire(g: GestionnairePersonne): void&lt;br&gt;+ demanderNom(): void&lt;br&gt;+ demanderMotDePasse(): void&lt;br&gt;+ autoriserConnexion(): void&lt;br&gt;+ interdireConnexion(): void&lt;br&gt;+ identification(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
